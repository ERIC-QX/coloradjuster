el('import-masters').addEventListener('click', () => { if (mayDiscardEditor()) { closeEditor(); el('import-file').click(); } });
el('import-file').addEventListener('change', () => importMasters(el('import-file').files[0]));
el('all-comparisons').addEventListener('toggle', renderComparisons);
window.addEventListener('beforeunload', event => { if ((unlocked && (editorDirty() || shadeDraftDirty || labMeasurementDirty || labRecipeDirty)) || pendingSaves > 0 || (!storageHealthy && envelope && portableRevision !== envelope.revision)) { event.preventDefault(); event.returnValue = ''; } });
wireShadeControls();
