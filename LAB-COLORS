['pointerdown', 'keydown', 'input', 'wheel'].forEach(type => document.addEventListener(type, () => { if (unlocked) lastActivity = Date.now(); }, {capture: true, passive: true}));
function checkIdle() { if (unlocked && !changingPassword && Date.now() - lastActivity >= IDLE_LIMIT) lockSession('Automatically locked after 15 minutes without activity. Enter your password to continue.'); }
setInterval(checkIdle, 5000);
document.addEventListener('visibilitychange', checkIdle);
window.addEventListener('pagehide', () => { if (unlocked) lockSession(); });
window.addEventListener('pageshow', event => { if (event.persisted && unlocked) lockSession('Please log in again after returning to this page.'); });

