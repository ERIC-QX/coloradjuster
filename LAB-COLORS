  } catch (error) { authMessage(error instanceof SyntaxError ? 'This is not a valid encrypted JSON backup.' : error.message, true); }
  finally { el('restore-file').value = ''; }
}
async function changePassword(event) {
  event.preventDefault();
  if (!unlocked || changingPassword) return;
  let oldPassword = el('old-password').value;
  let newPassword = el('new-password').value;
  const error = passwordError(newPassword, el('new-password-confirm').value);
  const msg = el('change-message');
  if (!oldPassword || error) { msg.textContent = !oldPassword ? 'Enter your current password.' : error; msg.dataset.error = 'true'; return; }
  changingPassword = true;
  el('save-password').disabled = true; el('cancel-password').disabled = true;
  msg.dataset.error = 'false'; msg.textContent = 'Checking and updating your password...';
  const epoch = sessionEpoch;
  try {
    await saveQueue;
    if (!unlocked || epoch !== sessionEpoch) return;
    await openEnvelope(envelope, oldPassword);
    const base = {...envelope, kdf: newKdf()};
    const key = await deriveVaultKey(newPassword, base.kdf);
    if (!unlocked || epoch !== sessionEpoch) return;
    const record = await sealLibrary(JSON.stringify(backupData()), key, base);
    if (!unlocked || epoch !== sessionEpoch) return;
    envelope = record; sessionKey = key; writeVault(record);
    clearChangeFields(); el('password-dialog').close();
    persistenceStatus();
    securityMessage(storageHealthy ? 'Password changed. Download a NEW locked copy and encrypted backup. Older files still use the old password; they cannot be revoked remotely.' : 'Password changed for this session, but browser storage could not be updated. Download a new locked copy now. The older saved browser library still uses its previous password.', !storageHealthy);
  } catch (_) {
    msg.textContent = 'The current password is incorrect, or the password could not be updated. No password change was completed.';
    msg.dataset.error = 'true';
    el('old-password').value = '';
  } finally {
    oldPassword = ''; newPassword = '';
    changingPassword = false;
    el('save-password').disabled = false; el('cancel-password').disabled = false;
    lastActivity = Date.now();
  }
}
function bootAuthentication() {
  cryptoSupported = Boolean(globalThis.crypto && crypto.subtle && globalThis.isSecureContext);
  if (!cryptoSupported) { authFatal = 'This browser context cannot use the required encryption. Download the HTML file and open it directly in Chrome or Edge, rather than inside a file preview.'; renderAuth(); return; }
  let embedded = null;
  try {
    const raw = JSON.parse(el('embedded-vault').textContent);
    if (raw) { embedded = validateEnvelope(raw); vaultStorageKey += '-' + embedded.id; }
  } catch (_) { authFatal = 'The embedded encrypted library is damaged. Restore a valid encrypted backup.'; }
  let saved = null;
  try { saved = localStorage.getItem(vaultStorageKey); lastStoredText = saved; }
  catch (_) { storageHealthy = false; }
  if (saved) {
    try { envelope = validateEnvelope(JSON.parse(saved)); }
    catch (_) { authFatal = 'The saved encrypted library could not be read. Restore an encrypted backup. It has not been overwritten.'; }
  } else envelope = embedded;
  renderAuth();
  if (!storageHealthy) authMessage('Browser storage is unavailable. After logging in or creating a password, download a locked copy before closing this tab.', true);
  if (!authFatal) el('login-password').focus({preventScroll: true});
}

